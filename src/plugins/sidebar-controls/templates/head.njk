{#- Set layout classes before first paint so pages don't flash or jump. -#}
{% set scRemember = pluginSettings.remember and (pluginSettings.toggleFileTree or pluginSettings.toggleSidebar) %}
{% if scRemember or pluginSettings.sidebarPosition == "edge" %}
<script>
  (function () {
    var root = document.documentElement;
    {% if pluginSettings.sidebarPosition == "edge" %}root.classList.add("sc-sidebar-edge");{% endif %}
    {% if scRemember %}
    try {
      var state = JSON.parse(localStorage.getItem("sidebar-controls") || "{}");
      {% if pluginSettings.toggleFileTree %}if (state.files) root.classList.add("sc-files-collapsed");{% endif %}
      {% if pluginSettings.toggleSidebar %}if (state.sidebar) root.classList.add("sc-sidebar-collapsed");{% endif %}
    } catch (e) {}
    {% endif %}
  })();
</script>
{% endif %}
