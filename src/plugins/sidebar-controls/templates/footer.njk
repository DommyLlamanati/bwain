{% if pluginSettings.toggleFileTree or pluginSettings.toggleSidebar %}
{% if pluginSettings.buttonPosition != "floating" %}
<div class="sc-corners">
  {% if pluginSettings.toggleFileTree %}
  <button type="button" class="sc-toggle sc-toggle-files" data-sc-panel="files" aria-pressed="false" aria-label="Toggle file tree" title="Toggle file tree">
    <i class="sc-icon-open" data-lucide="panel-left-close"></i><i class="sc-icon-closed" data-lucide="panel-left-open"></i>
  </button>
  {% endif %}
  {% if pluginSettings.toggleSidebar %}
  <button type="button" class="sc-toggle sc-toggle-sidebar" data-sc-panel="sidebar" aria-pressed="false" aria-label="Toggle right sidebar" title="Toggle right sidebar">
    <i class="sc-icon-open" data-lucide="panel-right-close"></i><i class="sc-icon-closed" data-lucide="panel-right-open"></i>
  </button>
  {% endif %}
</div>
{% endif %}
<script>
  (function () {
    var root = document.documentElement;
    var remember = {{ "true" if pluginSettings.remember else "false" }};
    var classes = { files: "sc-files-collapsed", sidebar: "sc-sidebar-collapsed" };

    function sync() {
      document.querySelectorAll(".sc-toggle").forEach(function (btn) {
        btn.setAttribute("aria-pressed", String(root.classList.contains(classes[btn.dataset.scPanel])));
      });
    }

    document.addEventListener("click", function (evt) {
      var btn = evt.target.closest(".sc-toggle");
      if (!btn) return;
      root.classList.toggle(classes[btn.dataset.scPanel]);
      sync();
      if (!remember) return;
      try {
        localStorage.setItem("sidebar-controls", JSON.stringify({
          files: root.classList.contains(classes.files),
          sidebar: root.classList.contains(classes.sidebar)
        }));
      } catch (e) {}
    });

    sync();
  })();
</script>
{% endif %}
