{#-
  Resolves the color mode before first paint: the visitor's stored choice,
  then (optionally) their system preference, then the garden's BASE_THEME.
  Runs in <head>, where <body> does not exist yet, so the body's theme class
  is swapped by a MutationObserver the moment the parser inserts <body>. Its
  callback runs as a microtask, before the browser gets a chance to paint.
-#}
{%- set ldmModes = pluginSettings.themeModes | lightDarkModes(meta.baseTheme) -%}
{%- if not meta.themeStyle %}
<link href="/plugins/light-dark-mode/assets/default-theme-light.css" rel="stylesheet">
{%- endif %}
{%- if ldmModes.length > 1 %}
<script>
  (function () {
    var KEY = "garden-light-dark-mode";
    var base = {{ meta.baseTheme | dump | safe }} === "light" ? "light" : "dark";
    var followSystem = {{ (pluginSettings.followSystem !== false) | dump | safe }};
    var root = document.documentElement;
    var media = window.matchMedia ? matchMedia("(prefers-color-scheme: dark)") : null;

    function stored() {
      try {
        var mode = localStorage.getItem(KEY);
        return mode === "light" || mode === "dark" ? mode : null;
      } catch (e) {
        return null;
      }
    }

    function system() {
      if (!followSystem || !media) return base;
      if (media.matches) return "dark";
      return matchMedia("(prefers-color-scheme: light)").matches ? "light" : base;
    }

    function applyToBody(mode) {
      document.body.classList.remove("theme-dark", "theme-light");
      document.body.classList.add("theme-" + mode);
    }

    function apply(mode) {
      root.setAttribute("data-color-mode", mode);
      root.style.colorScheme = mode;
      if (document.body) applyToBody(mode);
    }

    function get() {
      return root.getAttribute("data-color-mode");
    }

    function change(mode) {
      if (mode === get()) return;
      apply(mode);
      // The graph reads its colors once per render
      if (window.__graph && window.__graph.rerenderLocal) {
        try { window.__graph.rerenderLocal(); } catch (e) {}
      }
      document.dispatchEvent(
        new CustomEvent("dg:theme-change", { detail: { theme: mode, mode: mode } })
      );
    }

    function set(mode) {
      try {
        localStorage.setItem(KEY, mode);
      } catch (e) {}
      change(mode);
    }

    window.gardenLightDarkMode = {
      get: get,
      set: set,
      toggle: function () {
        set(get() === "dark" ? "light" : "dark");
      },
    };

    apply(stored() || system());

    if (!document.body) {
      new MutationObserver(function (records, observer) {
        if (!document.body) return;
        observer.disconnect();
        applyToBody(get());
      }).observe(root, { childList: true });
    }

    // Follow system changes until the visitor picks a mode themselves
    if (media) {
      var onSystemChange = function () {
        if (!stored()) change(system());
      };
      if (media.addEventListener) media.addEventListener("change", onSystemChange);
      else if (media.addListener) media.addListener(onSystemChange);
    }

    // Keep other open tabs in sync
    window.addEventListener("storage", function (event) {
      if (event.key === KEY) change(stored() || system());
    });
  })();
</script>
{%- endif %}
